{
  "name": "cdp-relay",
  "version": "0.1.0",
  "private": true,
  "description": "CCoW の隔離コンテナから手元 Chrome を CDP 操作する DO+WS リレー。MV3 拡張 → Cloudflare Worker+DO → stateless MCP を TCP/443 WSS 中継で合流させる。",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.71",
    "@cloudflare/workers-types": "^4.20250101.0",
    "@vitest/coverage-istanbul": "^3.2.4",
    "typescript": "^5.5.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.67.0"
  },
  "dependencies": {
    "@ippoan/mcp-cf-workers": "dev",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.4.3"
  }
}
